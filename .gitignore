# Patterns here are deliberately path-independent (**/ or bare names) so that
# renaming a module directory cannot silently disable an ignore rule.

# Local env and secrets — never commit tokens
.env
.env.local
.env.*.local
**/secrets/*.env
!**/secrets/*.env.example

# Personal deployment endpoints
**/.modal_url
**/.modal_urls/

# Downloaded models (fetch with scripts/download_gguf.py)
*.gguf
*.safetensors
*.bin

# Generated artifacts — regenerate, don't commit
**/results.json
**/results.html
**/*_with_outputs.pdf
**/*_with_outputs.html

# Python / tooling
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.DS_Store
